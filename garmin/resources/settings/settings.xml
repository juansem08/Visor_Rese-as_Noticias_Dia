<!-- Ajustes que aparecen en la app Garmin Connect del teléfono -->
<settings>
    <setting propertyKey="@Properties.Tema" title="@Strings.TituloTema">
        <settingConfig type="list">
            <listEntry value="0">@Strings.TemaMundo</listEntry>
            <listEntry value="1">@Strings.TemaTecnologia</listEntry>
            <listEntry value="2">@Strings.TemaDeportes</listEntry>
            <listEntry value="3">@Strings.TemaEconomia</listEntry>
            <listEntry value="4">@Strings.TemaCiencia</listEntry>
            <listEntry value="5">@Strings.TemaSalud</listEntry>
            <listEntry value="6">@Strings.TemaCultura</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.AvisoActivo" title="@Strings.TituloAviso">
        <settingConfig type="boolean"/>
    </setting>

    <setting propertyKey="@Properties.HoraAviso" title="@Strings.TituloHora" prompt="@Strings.PromptHora">
        <settingConfig type="numeric" min="0" max="23"/>
    </setting>

    <setting propertyKey="@Properties.MinutoAviso" title="@Strings.TituloMinuto">
        <settingConfig type="list">
            <listEntry value="0">@Strings.Min00</listEntry>
            <listEntry value="15">@Strings.Min15</listEntry>
            <listEntry value="30">@Strings.Min30</listEntry>
            <listEntry value="45">@Strings.Min45</listEntry>
        </settingConfig>
    </setting>
</settings>
